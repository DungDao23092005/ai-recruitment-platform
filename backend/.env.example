# Core
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-in-development-with-a-random-value

# Database Configuration (Microsoft SQL Server)
DATABASE_DRIVER=ODBC Driver 18 for SQL Server
DATABASE_HOST=localhost
DATABASE_PORT=1433
DATABASE_NAME=ai_recruitment_platform
DATABASE_USER=sa
DATABASE_PASSWORD=

# AI & Vector Database Configuration
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
VECTOR_DIMENSION=384
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
FINAL_SCORE_THRESHOLD=0.3

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN_IP_PER_MINUTE=20
RATE_LIMIT_LOGIN_EMAIL_PER_MINUTE=5
RATE_LIMIT_REGISTER_IP_PER_MINUTE=10
RATE_LIMIT_FORGOT_PASSWORD_IP_PER_MINUTE=5
RATE_LIMIT_FORGOT_PASSWORD_EMAIL_PER_MINUTE=3
RATE_LIMIT_VERIFY_OTP_IP_PER_MINUTE=10
RATE_LIMIT_AI_CHAT_PER_MINUTE=10
RATE_LIMIT_PARSE_RESUME_PER_MINUTE=5
RATE_LIMIT_PARSE_JD_PER_MINUTE=5
RATE_LIMIT_MATCH_PER_MINUTE=10
RATE_LIMIT_RECOMMENDATIONS_PER_MINUTE=10

# Trusted Proxies for safe client IP extraction (comma-separated)
TRUSTED_PROXIES=

# VNPAY Configuration (Sandbox defaults for development)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5173/payment-result
VNPAY_IPN_URL=http://localhost:8000/api/v1/payments/vnpay/ipn
VNPAY_TIMEOUT=15

# Email Configuration
EMAIL_PROVIDER=mailpit
EMAIL_FROM=AI Recruitment Platform <noreply@example.com>
RESEND_API_KEY=
