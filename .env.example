REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# AI / LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
