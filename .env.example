# System Configuration
NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1

# Backend Configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000
SECRET_KEY=your-super-secret-key-change-in-production

# Database Configuration (PostgreSQL)
