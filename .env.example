# Application
PROJECT_NAME=AI Recruitment Platform

# Runtime environment. One of: development, staging, production, testing.
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# API
API_V1_STR=/api/v1

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]


# Security
SECRET_KEY=change-me-in-development-with-a-random-value


# Database (Microsoft SQL Server)
DATABASE_DRIVER=ODBC Driver 18 for SQL Server
DATABASE_HOST=localhost
DATABASE_PORT=1433
DATABASE_NAME=ai_recruitment_platform
DATABASE_USER=change-me
DATABASE_PASSWORD=change-me


# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_DB=0


# Google Gemini (AI generation)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite


# Qdrant Vector Database
# Local Qdrant (development fallback)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Qdrant Cloud (production - takes priority when configured)
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key-here


# VNPAY Payment Gateway
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_IPN_URL=http://localhost:8000/api/v1/payments/vnpay/ipn
VNPAY_RETURN_URL=http://localhost:3000/payment-result
VNPAY_TIMEOUT=15


# Email Provider
# Options: mailpit, resend, gmail
EMAIL_PROVIDER=mailpit
EMAIL_FROM="AI Recruitment Platform <noreply@your-domain.com>"

# Mailpit (Development)
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Resend (Production)
RESEND_API_KEY=your-resend-api-key-here

# Gmail SMTP (Production)
GMAIL_USERNAME=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587